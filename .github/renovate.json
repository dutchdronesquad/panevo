{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dutchdronesquad/.github:renovate-base"],
  "packageRules": [
    {
      "groupName": "Radix UI",
      "groupSlug": "radix-ui",
      "matchPackageNames": ["@radix-ui/{/,}**"]
    },
    {
      "groupName": "Electron Forge",
      "groupSlug": "electron-forge",
      "matchPackageNames": ["/^@electron-forge\\//"]
    },
    {
      "matchManagers": ["github-actions"],
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
